fig, axs = plt.subplots(3, 3, figsize=(9, 9))
for row, (Kx, Ax, tag) in enumerate([(K_test, A_test, "WDM (test)"),
                                      (K_cdm, A_cdm, "CDM (0-shot)"),
                                      (K_axion, A_axion, "Axion (0-shot)")]):
