    axs[row,1].imshow(pred_mag, vmin=0, vmax=vmax); axs[row,1].set_title(f"CNN : {err:.4f}"); axs[row,1].axis('off')
    axs[row,2].imshow((pred_mag-true_mag).abs(), vmin=0, vmax=vmax); axs[row,2].set_title("|error|"); axs[row,2].axis('off')
