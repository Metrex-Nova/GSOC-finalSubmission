@torch.no_grad()
def sample_pred(model, x, y):
    model.eval()
    pred = model(x[None].to(DEVICE))[0].cpu()
    err = (((pred-y)**2).sum().sqrt() / ((y**2).sum().sqrt()+1e-8)).item()
    return pred, err

