# %% Cell -- train DeepONet on lensing (WDM train/test, CDM+axion zero-shot)
import time
import numpy as np
import torch
import torch.nn as nn
import matplotlib.pyplot as plt

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
SEED = 13
EPOCHS = 60
BATCH_SIZE = 32
print(DEVICE)

def rel_l2_loss(p, t):
    return (((p-t)**2).sum(dim=(1,2,3)).sqrt() / ((t**2).sum(dim=(1,2,3)).sqrt()+1e-8)).mean()

@torch.no_grad()
def evaluate(model, loader, grid):
    model.eval(); n = d = 0.
    for kb, ab in loader:
        kb, ab = kb.to(DEVICE), ab.to(DEVICE); p = model(kb, grid)
        n += ((p-ab)**2).sum(dim=(1,2,3)).sqrt().sum().item()
        d += (ab**2).sum(dim=(1,2,3)).sqrt().sum().item()
    return n/d

class MLPd(nn.Module):
    def __init__(self, sizes):
        super().__init__()
        layers = []
        for i in range(len(sizes)-2): layers += [nn.Linear(sizes[i], sizes[i+1]), nn.GELU()]
        layers += [nn.Linear(sizes[-2], sizes[-1])]; self.net = nn.Sequential(*layers)
    def forward(self, x): return self.net(x)

class DeepONet(nn.Module):
    def __init__(self, res=64, oc=2, p=96, branch_hidden=160, trunk_hidden=160, trunk_layers=5):
        super().__init__()
        self.res, self.oc, self.p = res, oc, p
        self.branch = MLPd([res*res, branch_hidden, branch_hidden, p*oc])
        self.trunk = MLPd([2] + [trunk_hidden]*trunk_layers + [p])
        self.bias = nn.Parameter(torch.zeros(oc))
    def forward(self, kappa, grid):
        B = kappa.shape[0]
        b = self.branch(kappa.reshape(B, -1)).view(B, self.oc, self.p)
        t = self.trunk(grid)
        return torch.einsum('bcp,np->bcn', b, t).view(B, self.oc, self.res, self.res) + self.bias.view(1,-1,1,1)

def make_grid(res, device):
    ys, xs = torch.meshgrid(torch.linspace(0,1,res), torch.linspace(0,1,res), indexing='ij')
    return torch.stack([xs.reshape(-1), ys.reshape(-1)], 1).to(device)

def count_params(model):
    return sum(p.numel() for p in model.parameters() if p.requires_grad)

torch.manual_seed(SEED); np.random.seed(SEED)
g = torch.Generator().manual_seed(SEED)
train_loader = torch.utils.data.DataLoader(torch.utils.data.TensorDataset(K_train, A_train), batch_size=BATCH_SIZE, shuffle=True, generator=g)
test_loader = torch.utils.data.DataLoader(torch.utils.data.TensorDataset(K_test, A_test), batch_size=BATCH_SIZE)
cdm_loader = torch.utils.data.DataLoader(torch.utils.data.TensorDataset(K_cdm, A_cdm), batch_size=BATCH_SIZE)
axion_loader = torch.utils.data.DataLoader(torch.utils.data.TensorDataset(K_axion, A_axion), batch_size=BATCH_SIZE)
grid = make_grid(RES, DEVICE)

model = DeepONet(res=RES, oc=2, p=96, branch_hidden=160, trunk_hidden=160, trunk_layers=5).to(DEVICE)
print(f"DeepONet (lensing) params: {count_params(model):,}")

opt = torch.optim.Adam(model.parameters(), lr=1e-3, weight_decay=1e-5)
sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS)

best_val, best_state = float("inf"), None
epoch_times = []
t_start = time.time()

for ep in range(EPOCHS):
    model.train(); t0 = time.time()
    for kb, ab in train_loader:
        kb, ab = kb.to(DEVICE), ab.to(DEVICE)
        opt.zero_grad(); rel_l2_loss(model(kb, grid), ab).backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step()
    sched.step()
    dt = time.time() - t0; epoch_times.append(dt)

    val_wdm = evaluate(model, test_loader, grid)
    val_cdm = evaluate(model, cdm_loader, grid)
    val_axion = evaluate(model, axion_loader, grid)
    if val_wdm < best_val:
        best_val = val_wdm
        best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}

    print(f"[DeepONet seed{SEED}] ep {ep:3d}  wdm {val_wdm:.4f}  (best {best_val:.4f})  "
          f"cdm(0-shot) {val_cdm:.4f}  axion(0-shot) {val_axion:.4f}  ({dt:.1f}s)")

total_time = time.time() - t_start
print(f"\n[DeepONet seed{SEED}] FINAL best wdm = {best_val:.4f} | median epoch {np.median(epoch_times):.2f}s | total {total_time/60:.2f} min")

model.load_state_dict(best_state)
final_wdm = evaluate(model, test_loader, grid)
final_cdm = evaluate(model, cdm_loader, grid)
final_axion = evaluate(model, axion_loader, grid)
print(f"FINAL (best ckpt) | wdm {final_wdm:.4f} | cdm(0-shot) {final_cdm:.4f} | axion(0-shot) {final_axion:.4f}")

@torch.no_grad()
def sample_pred(model, x, y, grid):
    model.eval()
    pred = model(x[None].to(DEVICE), grid)[0].cpu()
    err = (((pred-y)**2).sum().sqrt() / ((y**2).sum().sqrt()+1e-8)).item()
    return pred, err

